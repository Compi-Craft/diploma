graph TB
    U(["Locust Traffic"])

    subgraph K8s["☸ Kubernetes Cluster"]
        LB["Load Balancer"]
        App["cpu-service pods"]
        KEDA["KEDA ScaledObject"]
        HPA["HPA Controller"]
        LB --> App
        KEDA --> HPA -->|"scale pods"| App
    end

    Prom[("Prometheus")]

    subgraph LPA["LPA — Load Prediction Application (Docker Compose)"]
        Collector["Collector  ·  5s cycle"]
        Feat["Feature Engineering"]
        GRU["GRU Model"]
        Guard["OOD Guard + Cap"]
        API["REST API"]
        DB[("TimescaleDB")]
        Collector --> Feat --> GRU --> Guard
        Collector --> API --> DB
    end

    U -->|"HTTP"| LB
    App -. "scrape: CPU & RPS" .-> Prom
    Prom -->|"CPU & RPS"| Collector
    Guard -->|"prediction gauge"| Prom
    Prom -->|"ML prediction"| KEDA
    Prom -->|"CPU fallback"| KEDA

    style GRU fill:#f96,stroke:#333,stroke-width:2px
    style KEDA fill:#326ce5,color:#fff
    style HPA fill:#4a90d9,color:#fff
    style Prom fill:#e6522c,color:#fff
    style DB fill:#336791,color:#fff
    style Guard fill:#ffcc00,stroke:#b8860b,color:#333
    style Feat fill:#e8f4f8,stroke:#4a90d9
    style Collector fill:#f0f8e8,stroke:#5a9a2a
